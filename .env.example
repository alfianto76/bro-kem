NODE_ENV=production
PORT=5376
LOG_LEVEL=info
CORS_ORIGIN=*

# Only connect feeds/APIs that you own or are licensed to use.
CATALOG_API_URL=
CATALOG_API_TOKEN=

# Public catalog page you own or are permitted to scrape.
# Each movie is expected inside an <article> containing h1, img, and p.
SCRAPER_SOURCE_URL=
SCRAPER_ITEM_SELECTOR=article
SCRAPER_TIMEOUT_MS=10000
CACHE_TTL_SECONDS=300
